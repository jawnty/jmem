#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess


ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()


def plist_text(minute: int, limit: int) -> str:
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jmem.consolidate</string>

  <key>ProgramArguments</key>
  <array>
    <string>{ROOT / 'bin/jmem'}</string>
    <string>consolidate</string>
    <string>--quiet</string>
    <string>--limit</string>
    <string>{limit}</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>{minute}</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>{ROOT / 'logs/consolidate.log'}</string>

  <key>StandardErrorPath</key>
  <string>{ROOT / 'logs/consolidate.err.log'}</string>
</dict>
</plist>
"""


def main() -> int:
    parser = argparse.ArgumentParser(description="Install hourly jmem consolidation LaunchAgent on macOS.")
    parser.add_argument("--minute", type=int, default=37)
    parser.add_argument("--limit", type=int, default=50)
    parser.add_argument("--load", action="store_true", help="Load the LaunchAgent after writing it")
    args = parser.parse_args()
    if args.minute < 0 or args.minute > 59:
        parser.error("--minute must be between 0 and 59")
    if args.limit < 1:
        parser.error("--limit must be positive")
    path = HOME / "Library/LaunchAgents/com.jmem.consolidate.plist"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(plist_text(args.minute, args.limit))
    subprocess.run(["plutil", "-lint", str(path)], check=True)
    print(f"wrote {path}")
    if args.load:
        uid = str(os.getuid())
        subprocess.run(["launchctl", "bootout", f"gui/{uid}", str(path)], check=False)
        subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(path)], check=True)
        print("loaded com.jmem.consolidate")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
