#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()


def load_json(path: Path) -> dict:
    if not path.exists():
        return {}
    return json.loads(path.read_text())


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")


def ensure_hook(config: dict, event: str, command: str) -> bool:
    hooks = config.setdefault("hooks", {})
    entries = hooks.setdefault(event, [])
    for entry in entries:
        for hook in entry.get("hooks", []):
            if hook.get("command") == command:
                return False
    entries.append({
        "hooks": [{
            "type": "command",
            "command": command,
            "statusMessage": "Checking jmem",
        }]
    })
    return True


def install_codex() -> bool:
    path = HOME / ".codex/hooks.json"
    data = load_json(path)
    changed = ensure_hook(
        data,
        "UserPromptSubmit",
        str(ROOT / "bin/jmem-codex-hook") + " user-prompt",
    )
    if changed:
        write_json(path, data)
    print(f"codex_hooks={path} changed={changed}")
    return changed


def install_claude() -> bool:
    path = HOME / ".claude/settings.json"
    data = load_json(path)
    changed = ensure_hook(
        data,
        "UserPromptSubmit",
        str(ROOT / "bin/jmem-claude-hook") + " user-prompt",
    )
    if changed:
        write_json(path, data)
    print(f"claude_settings={path} changed={changed}")
    return changed


def main() -> int:
    parser = argparse.ArgumentParser(description="Install jmem hooks for local agent apps.")
    parser.add_argument("--codex", action="store_true", help="Install Codex UserPromptSubmit hook")
    parser.add_argument("--claude", action="store_true", help="Install Claude Code UserPromptSubmit hook")
    parser.add_argument("--all", action="store_true", help="Install all supported hooks")
    args = parser.parse_args()
    if not (args.codex or args.claude or args.all):
        parser.error("choose --codex, --claude, or --all")
    if args.codex or args.all:
        install_codex()
    if args.claude or args.all:
        install_claude()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

